<Project Sdk="Microsoft.NET.Sdk">
  <!-- Симуляция без ссылки на Godot: net10.0, как у Godot-проекта, который её использует. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DevAInt.Sim</RootNamespace>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Тесты видят internal-члены, чтобы проверять части sim, не делая их публичным API. -->
    <InternalsVisibleTo Include="DevAInt.Sim.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
  </ItemGroup>
</Project>
