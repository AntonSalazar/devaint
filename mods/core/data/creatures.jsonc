// Существа. Человек - вид персонажей игроков: свои статы, тело, удар кулаком и толчок.
{
  "$schema": "../../../schemas/data.schema.json",
  "creatures": [
    {
      "id": "core:human",
      "color": "#4a8cff",
      "radius": 0.3,
      "speed": 1.5,
      "stats": ["core:hunger", "core:thirst", "core:fatigue", "core:health"],
      "attack": { "range": 1.0, "seconds": 0.8, "stat": "core:health", "add": -25 },
      // Толчок без урона: цель отлетает на 1.2 м и секунду не может ни ходить, ни кусать
      "shove": { "range": 1.0, "seconds": 1.0, "push": 1.2, "stun": 1.0 },
      // Обзор: конус 140 градусов на 25 м и 1.5 м вокруг, где видно и за спиной; по нему клиент рисует видимое
      "vision": { "angle": 140, "range": 25, "near": 1.5 },
    },
  ],
}
