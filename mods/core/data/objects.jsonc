// Объекты мира: мебель на клетках. w и h - размер в клетках без поворота, height - высота в метрах,
// blocksMove - мешает ходить, blocksSight - закрывает обзор. Цвет - пока моделей нет.
{
  "$schema": "../../../schemas/data.schema.json",
  "objects": [
    { "id": "core:crate", "height": 0.6, "color": "#9a7b4f" },
    { "id": "core:table", "w": 2, "height": 0.8, "color": "#7a5532" },
    { "id": "core:wardrobe", "height": 2, "color": "#5b3a24", "blocksSight": true },
  ],
}
