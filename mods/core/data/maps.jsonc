        { "floor": "core:wood_floor", "x": 2, "y": 2, "w": 10, "h": 10 },
        { "walls": "core:wood_wall", "x": 4, "y": 4, "w": 6, "h": 5 },
        { "door": "core:wood_door", "x": 6, "y": 8, "side": "south" },
      ],
    },
  ],
}
