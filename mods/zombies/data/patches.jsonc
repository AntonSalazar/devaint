// Стартовая комната core: три зомби во дворе, распахнутая дверь и запасные точки появления.
{
  "$schema": "../../../schemas/data.schema.json",
  "patches": [
    { "op": "add", "target": "core:starter_room", "path": "creatures", "value": { "creature": "zombies:zombie", "x": 6, "y": 11 } },
    { "op": "add", "target": "core:starter_room", "path": "creatures", "value": { "creature": "zombies:zombie", "x": 2, "y": 11 } },
    { "op": "add", "target": "core:starter_room", "path": "creatures", "value": { "creature": "zombies:zombie", "x": 11, "y": 11 } },
    { "op": "set", "target": "core:starter_room", "path": "build.2.open", "value": true },
    // Запасные точки появления в углах двора, подальше от зомби; правило выбора - в scripts/spawn.lua
    { "op": "add", "target": "core:starter_room", "path": "spawn.points", "value": { "x": 2, "y": 2 } },
    { "op": "add", "target": "core:starter_room", "path": "spawn.points", "value": { "x": 11, "y": 2 } },
    { "op": "add", "target": "core:starter_room", "path": "spawn.points", "value": { "x": 11, "y": 6 } },
  ],
}
