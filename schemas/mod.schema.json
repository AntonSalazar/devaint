{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevAInt mod manifest",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "api": {
      "type": "integer"
    },
    "depends": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "loadAfter": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "api"
  ],
  "additionalProperties": false
}
